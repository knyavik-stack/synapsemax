{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "synapsemax",
  "main": "src/index.js",
  "compatibility_date": "2026-08-22",
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "vars": {
    "NEON_AUTH_URL": "https://ep-lively-bread-b1ewktwx.neonauth.c-5.eu-central-1.aws.neon.tech/neondb/auth"
  },
  "observability": {
    "enabled": true
  }
}